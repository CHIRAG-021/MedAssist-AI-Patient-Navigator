# ============================================================
#  MedAssist Patient Care Navigator — Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit your .env file to version control.
# ============================================================

# --- IBM Watsonx.ai Credentials ---
# Obtain from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Your IBM Cloud project ID from Watsonx.ai project settings
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Watsonx.ai API endpoint (region-specific)
# Dallas (us-south): https://us-south.ml.cloud.ibm.com
# Frankfurt (eu-de): https://eu-de.ml.cloud.ibm.com
# Tokyo (jp-tok):    https://jp-tok.ml.cloud.ibm.com
# London (eu-gb):    https://eu-gb.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- Granite Model Selection ---
# Available IBM Granite models (change as needed):
# ibm/granite-3-3-8b-instruct       (latest, recommended)
# ibm/granite-3-2-8b-instruct
# ibm/granite-3-1-8b-instruct
# ibm/granite-3-0-8b-instruct
# ibm/granite-13b-chat-v2
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# --- Flask Application Settings ---
FLASK_SECRET_KEY=change_this_to_a_long_random_secret_key_minimum_32_chars
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# --- Application Settings ---
APP_NAME=MedAssist Patient Care Navigator
APP_VERSION=1.0.0

# --- Model Generation Parameters ---
# Adjust these to control response style
MAX_NEW_TOKENS=1024
MIN_NEW_TOKENS=50
TEMPERATURE=0.3
TOP_P=0.9
TOP_K=50
REPETITION_PENALTY=1.1
